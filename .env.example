# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
# ---------------------------------------------------------------------------

# REQUIRED — without this the application form returns an error instead of
# sending. Get a free key at https://resend.com (Dashboard -> API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Where applications are delivered. Defaults to admin@surrecords.com.
APPLICATIONS_TO=admin@surrecords.com

# The "From" address. This MUST be on a domain you have verified in Resend
# (Dashboard -> Domains), otherwise Resend rejects the send.
#
# For testing before you verify a domain, use:
#   APPLICATIONS_FROM=Sur Records <onboarding@resend.dev>
# — but note that address only delivers to the email you signed up with.
APPLICATIONS_FROM=Sur Records <applications@surrecords.com>

# Your public URL. Used for SEO metadata and social share previews.
NEXT_PUBLIC_SITE_URL=https://surrecords.com

# REQUIRED for file uploads on the Contact form (demos, portfolios, etc).
# Vercel dashboard -> Storage -> Blob -> Connect to project. Without this,
# uploads fail with a clear error but the rest of the form still works.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxx

# REQUIRED for the Sur Access membership checkout to work. Get TEST mode
# keys immediately (no KYC needed) at https://dashboard.razorpay.com ->
# Settings -> API Keys. Swap for LIVE keys only once your Razorpay account
# is KYC-verified and you're ready to accept real payments.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
